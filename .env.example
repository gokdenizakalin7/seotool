# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (menü tarama, kalori tahmini, katalog eşleştirme hakemi, stok fotoğraf hakemi) ──
GEMINI_API_KEY=

# ── Katalog eşleştirme ──────────────────────────────────────────────────────
# Belirsiz eşleşmelerde Gemini'ye sor (varsayılan açık; 0/false kapatır)
CATALOG_MATCH_LLM=1
# Eşleştirmeyi tamamen kapat (acil durum)
CATALOG_MATCH_DISABLED=0
# Katalog indeksi önbellek süresi (ms)
CATALOG_INDEX_TTL_MS=600000

# ── İşletmeye özel AI görsel üretimi (Cloudflare Workers AI, ücretsiz 10.000 nöron/gün) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Günlük global ve işletme başına üst sınır (512x512 ≈ 26 nöron)
IMAGE_GEN_DAILY_CAP=150
IMAGE_GEN_ORG_DAILY_CAP=20

# ── Katalog görselleri toplu üretimi (scripts/catalog-images) ───────────────
# Stok fotoğraf arama (Pixabay anahtarı anında ücretsiz; Openverse anahtarsız da çalışır)
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Pollinations (enter.pollinations.ai → sk_ anahtar)
POLLINATIONS_API_KEY=
# Yerel Draw Things HTTP API (varsayılan http://127.0.0.1:7860)
DRAWTHINGS_URL=
# Seed dosyası (varsayılan ../qr-menu-seed/dist/seed.json)
SEED_FILE=

# ── Diğer ───────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
EMAIL_VERIFICATION_REQUIRED=
DISABLE_RATE_LIMIT=

# İşletme sitesi kök adresi (QR kodlar ve paylaşım bağlantıları bunu kodlar; derleme anında gömülür).
# Boşsa panelin açık olduğu alan adı kullanılır. Örn: https://qr-chef.com.tr
NEXT_PUBLIC_SITE_URL=
